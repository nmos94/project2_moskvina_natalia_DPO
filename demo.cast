[0.554, "o", "spawn python3 -m src.primitive_db.main\r\r\r\n"]
[0.063, "o", "\r\r\n***Операции с данными***\r\r\nФункции:\r\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\r\n<command> select from <имя_таблицы> - прочитать все записи\r\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> - обновить запись\r\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\r\n\r\r\n***Управление таблицами***\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех табли"]
[0.000, "o", "ц\r\r\n<command"]
[0.000, "o", "> drop_table <имя_таблицы> - удалить таблицу\r\r\n\r\r\nОбщие команды:\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[4.688, "o", "create_table employees name:str age:int salary:int\r\r\n"]
