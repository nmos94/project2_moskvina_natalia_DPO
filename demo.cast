[0.601, "o", "spawn python3 -m src.primitive_db.main\r\r\r\n"]
[0.044, "o", "***Процесс работы с таблицей***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[3.665, "o", "create_table users name:str age:int is_active:bool\r\r\n"]
[0.002, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.084, "o", "list_tables\r\r\n"]
[0.000, "o", "- users\r\r\n"]
[0.001, "o", ">>>Введите команду: "]
[3.684, "o", "create_table products title:str price:int\r\r\n"]
[0.001, "o", "Таблица \"products\" успешно создана со столбцами: ID:int, title:str, price:int\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.087, "o", "list_tables\r\r\n"]
[0.000, "o", "- users\r\r\n- products\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.940, "o", "create_table users name:str\r\r\n"]
[0.000, "o", "Ошибка: таблица 'users' уже существует\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.345, "o", "drop_table users\r\r\n"]
[0.001, "o", "Таблица \"users\" успешно удалена.\r\r\n"]
[0.001, "o", ">>>Введите команду: "]
[2.091, "o", "list_tables\r\r\n"]
[0.000, "o", "- products\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.673, "o", "drop_table nonexistent\r\r\n"]
[0.000, "o", "Ошибка: таблица 'nonexistent' не существует\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[1.722, "o", "help\r\r\n"]
[0.000, "o", "***Процесс работы с таблицей***\r\r\nФункции:\r\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> .. - создать таблицу\r\r\n<command> list_tables - показать список всех таблиц\r\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\r\n<command> exit - выход из программы\r\r\n<command> help - справочная информация\r\r\n\r\r\n"]
[0.000, "o", ">>>Введите команду: "]
[2.219, "o", "exit\r\r\n"]
[0.000, "o", "Выход из программы...\r\r\n"]
